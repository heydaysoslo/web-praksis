{
  "name": "web-praksis",
  "version": "0.1.1",
  "private": true,
  "dependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.0",
    "@styled-system/css": "^5.1.5",
    "autolinker": "^3.16.2",
    "buffer": "^6.0.3",
    "classcat": "^5.0.2",
    "framer-motion": "^11.0.0",
    "htmlparser2": "^9.0.0",
    "js-cookie": "^3.0.5",
    "lazysizes": "^5.3.2",
    "object-hash": "^3.0.0",
    "query-string": "^9.0.0",
    "react": "^18.2.0",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-html-parser": "^2.0.2",
    "react-intersection-observer": "^9.5.3",
    "react-mailchimp-subscribe": "^2.1.3",
    "react-router-dom": "^6.21.0",
    "react-scripts": "^5.0.1",
    "react-share": "^4.4.1",
    "react-slick": "^0.30.0",
    "sass": "^1.69.5",
    "smoothscroll-polyfill": "^0.4.4",
    "styled-components": "^6.1.6",
    "styled-system": "^5.1.5",
    "universal-cookie": "^4.0.4",
    "uuid": "^13.0.0",
    "wpapi": "^1.2.1"
  },
  "scripts": {
    "postinstall": "npm install @babel/plugin-syntax-dynamic-import@7.8.3 --no-save --legacy-peer-deps 2>/dev/null || true",
    "start-js": "craco start",
    "build-css": "sass --load-path=./src --load-path=./node_modules src/styles/app.scss:src/styles/app.css",
    "watch-css": "sass --load-path=./src --load-path=./node_modules src/styles/app.scss:src/styles/app.css --watch",
    "start": "npm-run-all -p watch-css start-js",
    "build": "npm run build-css && craco build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@craco/craco": "^7.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "npm-run-all": "^4.1.5"
  },
  "resolutions": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.0"
  }
}
